# --- Family calendar conflict monitor configuration ---

# The shared Family calendar (already filled in for you).
FAMILY_CALENDAR_ID=family04215781631001689506@group.calendar.google.com

# How far ahead to look for conflicts, and how "fresh" an event must be to
# alert (should be >= your cron interval, plus a small buffer).
LOOKAHEAD_DAYS=90
WINDOW_MINUTES=90

# Exception handling: events that name DIFFERENT family members never conflict.
# When true, a name-less event is attributed to whoever created it (suppresses
# more, but can hide a real conflict on a shared event). Default false = only
# suppress when BOTH titles name people. See README "Different named people".
USE_CREATOR_FALLBACK=false

# Who gets the alert.
ALERT_RECIPIENTS=edeitrick@gmail.com,davidcpcu@gmail.com

# Where the de-dup state lives.
STATE_PATH=state.json

# --- SMTP (auto-send) ---
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification) and paste the 16-char value into SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=edeitrick@gmail.com
SMTP_PASSWORD=
SMTP_FROM=edeitrick@gmail.com

# --- Google Calendar API ---
# Create an OAuth "Desktop app" client in Google Cloud Console, download it as
# credentials.json, and run `python3 monitor.py run` once interactively to
# produce token.json.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
